{
  "name": "@stratus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read API and live stream that backs the STRATUS Console",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@stratus/config": "workspace:*",
    "@stratus/event-contracts": "workspace:*",
    "@stratus/observability": "workspace:*",
    "@stratus/shared-types": "workspace:*",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "@stratus/security-rules": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
