{
  "name": "stratus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event-Driven Cloud Security & Infrastructure Intelligence Platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build && pnpm -r --filter \"./tools/**\" build",
    "dev": "docker compose -f infrastructure/docker/docker-compose.yml up -d && pnpm -r --parallel dev",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate": "pnpm --filter @stratus/event-simulator start",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down -v",
    "db:migrate": "pnpm --filter @stratus/api migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "postcss": "^8.5.23"
    }
  }
}
