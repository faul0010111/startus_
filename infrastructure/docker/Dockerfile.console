FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY . .
RUN pnpm install --no-frozen-lockfile \
 && pnpm --filter "./packages/**" build \
 && pnpm --filter @stratus/console build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production PORT=3000
RUN addgroup -S stratus && adduser -S stratus -G stratus
WORKDIR /app
COPY --from=build --chown=stratus:stratus /repo/apps/stratus-console/.next/standalone ./
COPY --from=build --chown=stratus:stratus /repo/apps/stratus-console/.next/static ./apps/stratus-console/.next/static
COPY --from=build --chown=stratus:stratus /repo/apps/stratus-console/public ./apps/stratus-console/public
USER stratus
EXPOSE 3000
CMD ["node", "apps/stratus-console/server.js"]
