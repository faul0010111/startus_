# STRATUS — example environment
#
# Copy to .env and adjust. Every variable below is validated at boot by the Zod
# schema in packages/config/src/index.ts: a service with a broken environment
# fails fast instead of reporting itself healthy.
#
# The values here match the local stack in infrastructure/docker/docker-compose.yml,
# so a fresh clone works with no edits.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Event bus
# ---------------------------------------------------------------------------
# From the host, reach the broker through the EXTERNAL listener on 19092.
# Inside the compose network the services use kafka:9092 instead — see
# docker-compose.apps.yml.
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=stratus

# ---------------------------------------------------------------------------
# Stores
# ---------------------------------------------------------------------------
# Local development credentials only. Never reuse these anywhere real: in
# Kubernetes POSTGRES_URL comes from the stratus-postgres secret.
POSTGRES_URL=postgres://stratus:stratus@localhost:5432/stratus
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=stratus

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------
# organizationId flows through every envelope and every query, but no identity
# provider is wired in yet. These are the demo values the seed data uses.
STRATUS_ORG_ID=org_demo
STRATUS_PROJECT_ID=proj_demo

# ---------------------------------------------------------------------------
# Service ports (optional)
# ---------------------------------------------------------------------------
# Each service derives its port variable from its own name and falls back to
# the default below, so these only need setting to move a service off its port.
STRATUS_API_PORT=4000
SIGNAL_ENGINE_PORT=4010
EVENT_PROCESSOR_PORT=4020
SECURITY_ENGINE_PORT=4030
RISK_ENGINE_PORT=4040
INCIDENT_SERVICE_PORT=4050

# ---------------------------------------------------------------------------
# Console (build-time)
# ---------------------------------------------------------------------------
# Read by next.config.mjs and inlined into the client bundle. Public by design —
# never put a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_STRATUS_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Simulator (optional)
# ---------------------------------------------------------------------------
SIGNAL_ENGINE_URL=http://localhost:4010
